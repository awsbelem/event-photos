# Copy to .env (gitignored) next to compose.yaml and adjust to the machine. Each worker processes one photo at a
# time and needs up to 1.2 GB, so keep EVENT_PHOTOS_MEMORY at or above workers × 1.2 GB.
EVENT_PHOTOS_WORKERS=1
EVENT_PHOTOS_MEMORY=1536m
EVENT_PHOTOS_CPUS=1.5
# Long side, in px, that photos are processed and delivered at; 0 keeps the original size (a 48 MP photo then
# needs about 3.2 GB on its own).
EVENT_PHOTOS_MAX_LONG_SIDE=4032
